        self.state_lock = threading.Lock()
        self.thread_local = threading.local()
        self.manifest = self._load_manifest()
        self.knowledge_bases = self._load_knowledge_bases()
        self.system_prompt = self._build_system_prompt()

        self.logger.info("V6 工作流已初始化。")
        self.logger.info("模型：%s，分析并发：%s", self.qa_model, self.qa_workers)

    def _build_logger(self) -> logging.Logger:
        logger = logging.getLogger(f"SalesQAWorkflowV6_{self.run_id}")
        logger.setLevel(logging.INFO)
        logger.propagate = False

        if logger.handlers:
            logger.handlers.clear()

        formatter = logging.Formatter("%(asctime)s | %(levelname)s | %(message)s")
        file_handler = logging.FileHandler(self.log_dir / f"workflow_v6_{self.run_id}.log", encoding="utf-8")
        file_handler.setFormatter(formatter)

        stream_handler = logging.StreamHandler(sys.stdout)
        stream_handler.setFormatter(formatter)

        logger.addHandler(file_handler)
        logger.addHandler(stream_handler)
        return logger

    def _get_session(self) -> requests.Session:
        session = getattr(self.thread_local, "session", None)
        if session is None:
            session = requests.Session()
            pool_size = max(16, self.qa_workers + 8)
            adapter = HTTPAdapter(pool_connections=pool_size, pool_maxsize=pool_size)
            session.mount("https://", adapter)
            session.mount("http://", adapter)
            self.thread_local.session = session
        return session

    def _auth_headers(self) -> Dict[str, str]:
        return {"Authorization": f"Bearer {self.api_key}"}

    def _request(
        self,
        method: str,
        url: str,
        *,
        headers: Optional[Dict[str, str]] = None,
        params: Optional[Dict[str, Any]] = None,
        json_payload: Optional[Dict[str, Any]] = None,
        files: Optional[Dict[str, Any]] = None,
        timeout: int = 60,
        attempts: int = 3,
        accepted_statuses: Optional[List[int]] = None,
    ) -> requests.Response:
        accepted = accepted_statuses or [200]
        last_error: Optional[Exception] = None

        for attempt in range(1, attempts + 1):
            try:
                response = self._get_session().request(
                    method=method,
                    url=url,
                    headers=headers,
                    params=params,
                    json=json_payload,
                    files=files,
                    timeout=timeout,
                )
                if response.status_code in accepted:
                    return response

                error = RuntimeError(f"HTTP {response.status_code}: {response.text[:1000]}")
                last_error = error
                if response.status_code in RETRYABLE_STATUS_CODES and attempt < attempts:
                    self.logger.warning("请求失败，准备重试 %s %s，第 %s 次：%s", method, url, attempt, error)
                    time.sleep(self._backoff_delay(attempt))
                    continue
                raise error
            except requests.RequestException as exc:
                last_error = exc
                if attempt < attempts:
                    self.logger.warning("网络异常，准备重试 %s %s，第 %s 次：%s", method, url, attempt, exc)
                    time.sleep(self._backoff_delay(attempt))
                    continue
                break

        raise RuntimeError(f"{method} {url} 请求失败：{last_error}")

    def _request_json(self, *args: Any, **kwargs: Any) -> Dict[str, Any]:
        response = self._request(*args, **kwargs)
        try:
            return response.json()
        except ValueError as exc:
            raise RuntimeError(f"接口返回非 JSON 数据：{exc}") from exc

    def _backoff_delay(self, attempt: int) -> int:
        return min(30, 2 ** (attempt - 1) * 2)

    def _load_knowledge_bases(self) -> Dict[str, str]:
        loaded: Dict[str, str] = {}
        if not self.knowledge_dir.exists():
            self.logger.info("未发现 knowledge_bases 目录，跳过知识库加载。")
            return loaded

        for path in sorted(self.knowledge_dir.glob("*.md")):
            try:
                content = path.read_text(encoding="utf-8").strip()
            except UnicodeDecodeError:
                content = path.read_text(encoding="utf-8-sig").strip()
            if content:
                loaded[path.stem] = content

        if "评分细则知识库" not in loaded:
            raise ValueError("评分细则知识库为空或不存在，已中止运行。")
        if "客情锚定" not in loaded:
            raise ValueError("客情锚定知识库为空或不存在，已中止运行。")

        self.logger.info("已加载非空知识库文件 %s 个。", len(loaded))
        self.logger.info("已加载知识库：%s", "、".join(sorted(loaded.keys())))
        return loaded

    def _build_system_prompt(self) -> str:
        sections = [BASE_SYSTEM_PROMPT]

        if self.knowledge_bases:
            sections.append("# 知识库使用说明")
            sections.append("若基础提示与评分细则知识库有冲突，必须优先遵循评分细则知识库。")
            sections.append("若知识库与音频事实冲突，必须以音频中真实可听见的事实为准。")
            for title, content in self.knowledge_bases.items():
                sections.append(f"## {title}")
                sections.append(content)

        return "\n\n".join(sections)

    def _now_iso(self) -> str:
        return datetime.now().isoformat(timespec="seconds")

    def _safe_stem(self, file_stem: str) -> str:
        safe = re.sub(r"[^\w\u4e00-\u9fff-]+", "_", file_stem).strip("_")
        return safe[:60] or "audio"

    def _build_file_id(self, file_path: Path, file_size: int, modified_time: float) -> str:
        raw = f"{file_path.resolve()}|{file_size}|{int(modified_time)}"
        return hashlib.sha1(raw.encode("utf-8")).hexdigest()[:12]

    def _empty_manifest(self) -> Dict[str, Any]:
        return {"manifest_version": 1, "updated_at": self._now_iso(), "files": {}}

    def _load_manifest(self) -> Dict[str, Any]:
        if not self.manifest_path.exists():
            return self._empty_manifest()

        try:
            with self.manifest_path.open("r", encoding="utf-8") as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            self.logger.warning("manifest.json 读取失败，已自动重建。")
            return self._empty_manifest()

        if not isinstance(data, dict):
            return self._empty_manifest()

        data.setdefault("manifest_version", 1)
        data.setdefault("updated_at", self._now_iso())
        data.setdefault("files", {})
        return data

    def _atomic_write_text(self, path: Path, content: str, encoding: str = "utf-8") -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        temp_path = path.with_suffix(path.suffix + ".tmp")
        with temp_path.open("w", encoding=encoding, newline="") as handle:
            handle.write(content)
        os.replace(temp_path, path)

    def _atomic_write_json(self, path: Path, payload: Any) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        temp_path = path.with_suffix(path.suffix + ".tmp")
        with temp_path.open("w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, indent=2)
        os.replace(temp_path, path)

    def _atomic_write_csv(self, path: Path, rows: List[List[str]], header: List[str]) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        temp_path = path.with_suffix(path.suffix + ".tmp")
        with temp_path.open("w", encoding="utf-8-sig", newline="") as handle:
            writer = csv.writer(handle)
            writer.writerow(header)
            writer.writerows(rows)
        os.replace(temp_path, path)

    def _write_primary_or_fallback_csv(self, path: Path, rows: List[List[str]], header: List[str], fallback_path: Optional[Path] = None) -> Path:
        try:
            self._atomic_write_csv(path, rows, header=header)
            return path
        except PermissionError:
            if not fallback_path:
                raise
            self.logger.warning("目标文件被占用，改为写入备用文件：%s", fallback_path)
            self._atomic_write_csv(fallback_path, rows, header=header)
            return fallback_path

    def _display_path(self, path: Path) -> str:
        try:
            return str(path.relative_to(self.output_dir))
        except ValueError:
            return str(path)

    def _copy_if_exists(self, source: Path, target: Path) -> None:
        if not source.exists():
            return
        target.parent.mkdir(parents=True, exist_ok=True)
        try:
            shutil.copyfile(source, target)
        except PermissionError:
            self.logger.warning("目标文件被占用，暂时跳过同步：%s", target)

    def _save_manifest(self) -> None:
        with self.state_lock:
            self.manifest["updated_at"] = self._now_iso()
            self._atomic_write_json(self.manifest_path, self.manifest)

    def _upsert_entry(self, entry: Dict[str, Any]) -> None:
        with self.state_lock:
            entry["updated_at"] = self._now_iso()
            self.manifest["files"][entry["file_id"]] = entry.copy()
            self.manifest["updated_at"] = entry["updated_at"]
            self._atomic_write_json(self.manifest_path, self.manifest)

    def _reset_analysis_state(self, entry: Dict[str, Any]) -> None:
        entry["analysis_status"] = "pending"
        entry["analysis_attempts"] = 0
        entry["row_count"] = 0
        entry["error_message"] = ""
        entry["analysis_completed_at"] = ""

    def prepare_entries(
        self,
        file_paths: List[Path],
        *,
        force_reanalyze: bool = False,
    ) -> List[Dict[str, Any]]:
        current_entries: List[Dict[str, Any]] = []

        for index, file_path in enumerate(file_paths, start=1):
            stat = file_path.stat()
            file_id = self._build_file_id(file_path, stat.st_size, stat.st_mtime)
            safe_stem = self._safe_stem(file_path.stem)
            artifact_prefix = f"{safe_stem}_{file_id}"
            raw_output_path = self.raw_output_dir / f"omni原始输出_{artifact_prefix}.txt"
            result_json_path = self.file_result_dir / f"结果_{artifact_prefix}.json"
            result_csv_path = self.file_result_dir / f"结果_{artifact_prefix}.csv"

            existing = self.manifest["files"].get(file_id, {})
            entry: Dict[str, Any] = {
                "file_id": file_id,
                "run_index": index,
                "source_path": str(file_path.resolve()),
                "source_name": file_path.name,
                "source_size": stat.st_size,
                "source_mtime": int(stat.st_mtime),
                "audio_format": self.detect_audio_format(file_path),
                "artifact_prefix": artifact_prefix,
                "raw_output_path": str(raw_output_path),
                "result_json_path": str(result_json_path),
                "result_csv_path": str(result_csv_path),
                "analysis_status": "pending",
                "analysis_attempts": 0,
                "row_count": 0,
                "error_message": "",
                "selected_at": self._now_iso(),
                "updated_at": self._now_iso(),
                "analysis_completed_at": "",
                "last_uploaded_audio_url": "",
            }
            entry.update(existing)
            entry["run_index"] = index
            entry["source_path"] = str(file_path.resolve())
            entry["source_name"] = file_path.name
            entry["source_size"] = stat.st_size
            entry["source_mtime"] = int(stat.st_mtime)
            entry["audio_format"] = self.detect_audio_format(file_path)
            entry["artifact_prefix"] = artifact_prefix
            entry["raw_output_path"] = str(raw_output_path)
            entry["result_json_path"] = str(result_json_path)
            entry["result_csv_path"] = str(result_csv_path)

            if force_reanalyze:
                self._reset_analysis_state(entry)
            else:
                result_rows = self._read_result_rows(Path(entry["result_json_path"]))
                if result_rows:
                    entry["analysis_status"] = "succeeded"
                    entry["row_count"] = len(result_rows)
                    entry["error_message"] = ""
                elif entry.get("analysis_status") == "succeeded":
                    self._reset_analysis_state(entry)
                elif entry.get("analysis_status") == "failed":
                    entry["analysis_status"] = "pending"
                    entry["analysis_attempts"] = 0

            self._upsert_entry(entry)
            current_entries.append(entry)

        return current_entries

    def discover_audio_files(self, input_dir: Path, patterns: List[str], max_files: int = 0) -> List[Path]:
        files: Dict[str, Path] = {}
        for pattern in patterns:
            for path in sorted(input_dir.glob(pattern)):
                if path.is_file():
                    files[str(path.resolve()).lower()] = path

        ordered_files = sorted(files.values(), key=lambda item: item.name.lower())
        if max_files > 0:
            ordered_files = ordered_files[:max_files]
        return ordered_files

    def detect_audio_format(self, audio_path: Path) -> str:
        suffix = audio_path.suffix.lower().lstrip(".")
        if suffix in {"wav", "mp3", "m4a", "aac", "amr", "flac"}:
            return suffix
        raise ValueError(f"不支持的音频格式：{audio_path.name}")

    def upload_audio(self, entry: Dict[str, Any], attempt: int) -> str:
        file_path = Path(entry["source_path"])
        policy_json = self._request_json(
            "GET",
            f"{self.base_url}/uploads",
            headers=self._auth_headers(),
            params={"action": "getPolicy", "model": self.qa_model},
            timeout=self.default_timeout,
            attempts=self.http_attempts,
        )
        policy = policy_json.get("data")
        if not policy:
            raise RuntimeError(f"获取上传凭证失败：{policy_json}")

        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        object_key = (
            f"{policy['upload_dir'].rstrip('/')}/"
            f"{self.run_id}_{entry['file_id']}_attempt{attempt}_{timestamp}_{file_path.name}"
        )

        with file_path.open("rb") as audio_file:
            files = {
                "key": (None, object_key),
                "OSSAccessKeyId": (None, policy["oss_access_key_id"]),
                "policy": (None, policy["policy"]),
                "Signature": (None, policy["signature"]),
                "x-oss-object-acl": (None, policy.get("x_oss_object_acl", "private")),
                "x-oss-forbid-overwrite": (None, policy.get("x_oss_forbid_overwrite", "true")),
                "success_action_status": (None, "200"),
                "file": (file_path.name, audio_file),
            }
            self._request(
                "POST",
                policy["upload_host"],
                files=files,
                timeout=self.upload_timeout,
                attempts=1,
            )

        audio_url = f"oss://{object_key}"
        entry["last_uploaded_audio_url"] = audio_url
        self._upsert_entry(entry)
        return audio_url

