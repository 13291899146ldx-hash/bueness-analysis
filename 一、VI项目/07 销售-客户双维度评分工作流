        self.stable_long_output_path = self.output_dir / "测试汇总表_qwen3.5-omni-plus.csv"
        self.fallback_long_output_path = self.output_dir / f"测试汇总表_qwen3.5-omni-plus_{self.run_id}.csv"

        for directory in [
            self.output_dir,
            self.state_dir,
            self.raw_output_dir,
