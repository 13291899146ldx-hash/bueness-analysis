    def _extract_message_text(self, response: Dict[str, Any]) -> str:
        try:
            content = response["choices"][0]["message"]["content"]
        except (KeyError, IndexError, TypeError) as exc:
            raise RuntimeError(f"模型响应异常：{response}") from exc

        if isinstance(content, str):
            return content

        if isinstance(content, list):
            parts: List[str] = []
            for item in content:
                if isinstance(item, str):
                    parts.append(item)
                elif isinstance(item, dict):
                    text = item.get("text") or item.get("content") or ""
                    if text:
                        parts.append(str(text))
            joined = "".join(parts).strip()
            if joined:
                return joined

        raise RuntimeError(f"无法从模型响应中提取文本：{response}")

    def analyze_audio(self, entry: Dict[str, Any], strict_mode: bool = False) -> str:
        audio_url = self.upload_audio(entry, entry.get("analysis_attempts", 1))
        payload = {
            "model": self.qa_model,
            "temperature": 0,
            "max_tokens": 16000,
            "modalities": ["text"],
            "messages": [
                {"role": "system", "content": self.system_prompt},
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "input_audio",
                            "input_audio": {
                                "data": audio_url,
                                "format": entry["audio_format"],
                            },
                        },
                        {
                            "type": "text",
                            "text": self._omni_user_prompt(strict_mode=strict_mode),
                        },
                    ],
                },
            ],
        }
        response = self._request_json(
            "POST",
            self.chat_url,
            headers={
                **self._auth_headers(),
                "Content-Type": "application/json",
                "X-DashScope-OssResourceResolve": "enable",
            },
            json_payload=payload,
            timeout=self.chat_timeout,
            attempts=self.http_attempts,
        )
        return self._extract_message_text(response).strip()

    def _sanitize_reason(self, reason: str) -> str:
        cleaned = reason.replace("\r", " ").replace("\n", " ").strip()
        cleaned = re.sub(r"\s+", " ", cleaned)
        cleaned = cleaned.translate(ASCII_PUNCT_TRANSLATION)
        return cleaned

    def _normalize_score(self, raw_score: str) -> Optional[int]:
        match = re.search(r"\d+", raw_score or "")
        if not match:
            return None
        value = int(match.group())
        if 0 <= value <= 100:
            return value
        return None

    def _normalize_feature_name(self, feature: str) -> Optional[str]:
        key = normalize_text_key(feature)
        if key in FEATURE_NAME_MAP:
            return FEATURE_NAME_MAP[key]

        for canonical_feature in FEATURE_ORDER:
            canonical_key = normalize_text_key(canonical_feature)
            if key and (key in canonical_key or canonical_key in key):
                return canonical_feature
        return None

    def _normalize_meta_feature_name(self, feature: str) -> Optional[str]:
        key = normalize_text_key(feature)
        for meta_feature in META_FEATURES:
            meta_key = normalize_text_key(meta_feature)
            if key == meta_key or (key and (key in meta_key or meta_key in key)):
                return meta_feature
        return None

    def _strip_markdown(self, raw_text: str) -> str:
        text = raw_text.replace("\ufeff", "").strip()
        text = re.sub(r"```(?:csv)?", "", text, flags=re.IGNORECASE)
        return text.replace("```", "").strip()

    def _sanitize_meta_value(self, value: str) -> str:
        cleaned = value.replace("\r", " ").replace("\n", " ").strip()
        cleaned = re.sub(r"\s+", " ", cleaned)
        cleaned = cleaned.translate(ASCII_PUNCT_TRANSLATION)
        return cleaned

    def _extract_customer_type_name(self, value: str) -> str:
        for customer_type in CUSTOMER_TYPE_NAMES:
            if customer_type in value:
                return customer_type
        return value.strip()

    def _extract_meta_from_raw_text(self, text: str, communication_id: str, meta_feature: str) -> str:
        escaped_comm = re.escape(communication_id)
        escaped_feature = re.escape(meta_feature)
        pattern = rf"{escaped_comm}\s*,\s*{escaped_feature}\s*,\s*[^,]*\s*,\s*(.+)"
        match = re.search(pattern, text)
        if not match:
            return ""
        return self._sanitize_meta_value(match.group(1))

    def _dense_rows_from_parsed_items(
        self,
        source_name: str,
        parsed_items: List[Dict[str, Any]],
        meta_items: List[Dict[str, Any]],
        *,
        allow_fill_missing: bool,
    ) -> List[Dict[str, Any]]:
        grouped: Dict[str, Dict[str, Dict[str, str]]] = {}
        communication_order: List[str] = []
        grouped_meta: Dict[str, Dict[str, str]] = {}

        for item in parsed_items:
            raw_communication_id = item["communication_id"] or "场次1"
            if raw_communication_id not in grouped:
                grouped[raw_communication_id] = {}
                communication_order.append(raw_communication_id)

            feature = item["feature"]
            existing = grouped[raw_communication_id].get(feature)
            if existing is None or len(item["reason"]) > len(existing["reason"]):
                grouped[raw_communication_id][feature] = {
                    "score": item["score"],
                    "reason": item["reason"],
                }

        for item in meta_items:
            raw_communication_id = item["communication_id"] or "场次1"
            if raw_communication_id not in grouped:
                grouped[raw_communication_id] = {}
                communication_order.append(raw_communication_id)
            grouped_meta.setdefault(raw_communication_id, {})[item["feature"]] = item["value"]

        if not communication_order:
            raise RuntimeError("模型输出中未识别到任何有效场次。")

        scene_results: List[Dict[str, Any]] = []
        missing_messages: List[str] = []

        for scene_index, raw_communication_id in enumerate(communication_order, start=1):
            normalized_communication_id = f"场次{scene_index}"
            feature_map = grouped[raw_communication_id]
            meta_map = grouped_meta.get(raw_communication_id, {})
            rows: List[List[str]] = []
            for feature in FEATURE_ORDER:
                if feature in feature_map:
                    rows.append(
                        [
                            source_name,
                            normalized_communication_id,
                            feature,
                            feature_map[feature]["score"],
                            feature_map[feature]["reason"],
                        ]
                    )
                else:
                    missing_messages.append(f"{normalized_communication_id} 缺少特征 {feature}")
                    if allow_fill_missing:
                        rows.append(
                            [
                                source_name,
                                normalized_communication_id,
                                feature,
                                "0",
                                "对话闭环结论：本段标签【待复核】未能从模型输出中完整识别。具体分析：模型本次未返回该特征行，程序按缺失补零，建议结合音频与原始输出人工复核。",
                            ]
                        )

            scene_results.append(
                {
                    "file_name": source_name,
                    "communication_id": normalized_communication_id,
                    "customer_type": meta_map.get("客户类型", ""),
                    "customer_type_reason": meta_map.get("客户类型判断原因", ""),
                    "best_script_snippets": meta_map.get("该场景类型下优秀话术片段", ""),
                    "rows": rows,
                }
            )

        if missing_messages and not allow_fill_missing:
            preview = "；".join(missing_messages[:8])
            raise RuntimeError(f"模型输出特征不完整：{preview}")

        return scene_results

    def parse_qa_output(
        self,
        raw_output: str,
        source_name: str,
        *,
        allow_fill_missing: bool = False,
    ) -> List[Dict[str, Any]]:
        text = self._strip_markdown(raw_output)
        parsed_items: List[Dict[str, str]] = []
        meta_items: List[Dict[str, str]] = []
        invalid_lines: List[str] = []

        for raw_line in text.splitlines():
            line = raw_line.strip()
            if not line:
                continue
            if "沟通ID" in line and "评分原因" in line:
                continue
            if line.startswith("文件名"):
                continue

            try:
                parsed = next(csv.reader([line]))
            except Exception:
                parsed = line.split(",", 3)

            if len(parsed) < 4:
                invalid_lines.append(line)
                continue

            if len(parsed) > 4:
                first_cell = parsed[0].strip().lower()
                if first_cell.endswith((".wav", ".mp3", ".m4a", ".aac", ".amr", ".flac")) or "文件名" in parsed[0]:
                    parsed = parsed[-4:]
                else:
                    parsed = [parsed[0], parsed[1], parsed[2], ",".join(parsed[3:])]

            communication_id = parsed[0].strip()
            raw_feature = parsed[1].strip()
            meta_feature = self._normalize_meta_feature_name(raw_feature)
            feature = self._normalize_feature_name(raw_feature)
            score_text = parsed[2].strip()
            reason = self._sanitize_reason(parsed[3].strip())

            if communication_id == "沟通ID" or raw_feature == "特征":
                continue
            if meta_feature:
                meta_value = self._sanitize_meta_value(parsed[3].strip())
                if not meta_value:
                    invalid_lines.append(line)
                    continue
                if meta_feature == "客户类型":
                    meta_value = self._extract_customer_type_name(meta_value)
                meta_items.append(
                    {
                        "communication_id": communication_id,
                        "feature": meta_feature,
                        "value": meta_value,
                    }
                )
                continue

            score = self._normalize_score(score_text)
            if not feature or score is None or not reason:
                invalid_lines.append(line)
                continue

            parsed_items.append(
                {
                    "communication_id": communication_id,
                    "feature": feature,
                    "score": str(score),
                    "reason": reason,
                }
            )

        if not parsed_items:
            raise RuntimeError(f"模型输出未解析到有效 CSV 行。原始输出：{text[:1200]}")

        if invalid_lines:
            self.logger.warning("文件 [%s] 存在 %s 行无法解析，已自动跳过。", source_name, len(invalid_lines))

        scene_results = self._dense_rows_from_parsed_items(
            source_name,
            parsed_items,
            meta_items,
            allow_fill_missing=allow_fill_missing,
        )

        for scene in scene_results:
            communication_id = scene["communication_id"]
            if not scene.get("customer_type_reason"):
                scene["customer_type_reason"] = self._extract_meta_from_raw_text(text, communication_id, "客户类型判断原因")
            if not scene.get("best_script_snippets"):
                scene["best_script_snippets"] = self._extract_meta_from_raw_text(text, communication_id, "该场景类型下优秀话术片段")
            if scene.get("customer_type"):
                scene["customer_type"] = self._extract_customer_type_name(scene["customer_type"])

        return scene_results

    def _flatten_scene_results(self, scene_results: List[Dict[str, Any]]) -> List[List[str]]:
        rows: List[List[str]] = []
        for scene in scene_results:
            communication_id = scene["communication_id"]
            if scene.get("customer_type"):
                rows.append([scene["file_name"], communication_id, "客户类型", "0", scene["customer_type"]])
            if scene.get("customer_type_reason"):
                rows.append([scene["file_name"], communication_id, "客户类型判断原因", "0", scene["customer_type_reason"]])
            if scene.get("best_script_snippets"):
                rows.append([scene["file_name"], communication_id, "该场景类型下优秀话术片段", "0", scene["best_script_snippets"]])
            rows.extend(scene["rows"])
        return rows

    def _write_result_csv(self, path: Path, scene_results: List[Dict[str, Any]]) -> None:
        header = ["文件名", "沟通ID", "特征", "分数", "评分原因"]
        self._atomic_write_csv(path, self._flatten_scene_results(scene_results), header=header)

    def run_analysis_pipeline(self, entry: Dict[str, Any]) -> List[Dict[str, Any]]:
        last_error = ""
        for attempt in range(entry.get("analysis_attempts", 0) + 1, self.max_analysis_attempts + 1):
            try:
                entry["analysis_status"] = "running"
                entry["analysis_attempts"] = attempt
                entry["error_message"] = ""
                self._upsert_entry(entry)

                raw_output = self.analyze_audio(entry, strict_mode=attempt > 1)
                raw_path = Path(entry["raw_output_path"])
                if attempt == 1:
                    output_path = raw_path
                else:
                    output_path = raw_path.with_name(f"{raw_path.stem}_attempt{attempt}{raw_path.suffix}")
                self._atomic_write_text(output_path, raw_output, encoding="utf-8")

                scene_results = self.parse_qa_output(
                    raw_output,
                    entry["source_name"],
                    allow_fill_missing=attempt == self.max_analysis_attempts,
                )
                flattened_rows = self._flatten_scene_results(scene_results)
                self._atomic_write_json(Path(entry["result_json_path"]), scene_results)
                self._write_result_csv(Path(entry["result_csv_path"]), scene_results)

                entry["analysis_status"] = "succeeded"
                entry["analysis_completed_at"] = self._now_iso()
                entry["row_count"] = len(flattened_rows)
                entry["error_message"] = ""
                self._upsert_entry(entry)
                return scene_results
            except Exception as exc:
                last_error = str(exc)
                entry["analysis_status"] = "pending"
                entry["error_message"] = last_error
                self._upsert_entry(entry)
                self.logger.warning("音频直分析失败 [%s] 第 %s 次：%s", entry["source_name"], attempt, last_error)
                if attempt < self.max_analysis_attempts:
                    time.sleep(self._backoff_delay(attempt))

        raise RuntimeError(f"音频直分析失败：{last_error}")

    def _read_result_rows(self, path: Path) -> List[Dict[str, Any]]:
        rows: List[Dict[str, Any]] = []
        if not path.exists():
            return rows
        with path.open("r", encoding="utf-8") as handle:
            payload = json.load(handle)
        if isinstance(payload, list):
            for row in payload:
                if isinstance(row, dict) and row.get("communication_id") and isinstance(row.get("rows"), list):
                    rows.append(row)
        return rows

    def _communication_sort_key(self, communication_id: str) -> tuple[int, str]:
        match = re.search(r"(\d+)", communication_id or "")
        return (int(match.group(1)) if match else 10**9, communication_id or "")

    def _entry_status_label(self, entry: Dict[str, Any]) -> str:
        if entry.get("analysis_status") == "succeeded":
            return "成功"
        if entry.get("analysis_status") == "failed":
            return "分析失败"
        if entry.get("analysis_status") == "running":
            return "分析中"
        return "待处理"

    def _build_long_rows(self, entries: List[Dict[str, Any]]) -> List[List[str]]:
        rows: List[List[str]] = []
        for entry in sorted(entries, key=lambda item: item["run_index"]):
            result_rows = self._read_result_rows(Path(entry["result_json_path"]))
            if not result_rows:
                continue

            sorted_scenes = sorted(result_rows, key=lambda item: self._communication_sort_key(item["communication_id"]))
            for scene in sorted_scenes:
                feature_map = {row[2]: row for row in scene["rows"]}
                recording_id = Path(scene["file_name"]).stem
                first_row_of_scene = True
                current_dimension = ""

                for feature in FEATURE_ORDER:
                    row = feature_map.get(feature)
                    if not row:
                        continue
                    dimension = DIMENSION_BY_FEATURE[feature]
                    show_dimension = dimension if dimension != current_dimension else ""
                    current_dimension = dimension
                    rows.append(
                        [
                            recording_id,
                            scene["communication_id"],
                            scene["customer_type"] if first_row_of_scene else "",
                            scene["customer_type_reason"] if first_row_of_scene else "",
                            show_dimension,
                            feature,
                            FEATURE_WEIGHT_MAP.get(feature, ""),
                            row[3],
                            row[4],
                            scene["best_script_snippets"] if first_row_of_scene else "",
                        ]
                    )
                    first_row_of_scene = False
        return rows

    def _sync_latest_outputs(self) -> None:
        if self.latest_wide_output_path != self.run_output_path:
            self._copy_if_exists(self.run_output_path, self.latest_wide_output_path)
        if self.latest_long_output_path != self.run_long_output_path:
            self._copy_if_exists(self.run_long_output_path, self.latest_long_output_path)
        if self.stable_long_output_path != self.run_long_output_path:
            self._copy_if_exists(self.run_long_output_path, self.stable_long_output_path)

    def rebuild_outputs(self, entries: List[Dict[str, Any]]) -> None:
        header = ["文件名", "沟通ID", "处理状态", "错误信息", "模型原始输出路径", "客户类型", "客户类型判断原因", "该场景类型下优秀话术片段"]
        for feature in FEATURE_ORDER:
            header.append(f"{feature}_权重")
            header.append(f"{feature}_分数")
            header.append(f"{feature}_评分原因")

        wide_rows: List[List[str]] = []

        for entry in sorted(entries, key=lambda item: item["run_index"]):
            result_rows = self._read_result_rows(Path(entry["result_json_path"]))
            raw_output_path = self._display_path(Path(entry["raw_output_path"]))
            if result_rows:
                grouped: Dict[str, Dict[str, str]] = {}
                for scene in result_rows:
                    file_name = scene["file_name"]
                    communication_id = scene["communication_id"]
                    row_map = grouped.setdefault(
                        communication_id,
                        {
                            "文件名": file_name,
                            "沟通ID": communication_id,
                            "处理状态": "成功",
                            "错误信息": "",
                            "模型原始输出路径": raw_output_path,
                            "客户类型": scene.get("customer_type", ""),
                            "客户类型判断原因": scene.get("customer_type_reason", ""),
                            "该场景类型下优秀话术片段": scene.get("best_script_snippets", ""),
                        },
                    )
                    for _, _, feature, score, reason in scene["rows"]:
                        row_map[f"{feature}_权重"] = FEATURE_WEIGHT_MAP.get(feature, "")
                        row_map[f"{feature}_分数"] = score
                        row_map[f"{feature}_评分原因"] = reason

                for communication_id in sorted(grouped.keys(), key=self._communication_sort_key):
                    row_map = grouped[communication_id]
                    wide_rows.append([row_map.get(column, "") for column in header])
            else:
                row_map = {
                    "文件名": entry.get("source_name", ""),
                    "沟通ID": "",
                    "处理状态": self._entry_status_label(entry),
                    "错误信息": entry.get("error_message", ""),
                    "模型原始输出路径": raw_output_path if Path(entry["raw_output_path"]).exists() else "",
                }
                wide_rows.append([row_map.get(column, "") for column in header])

        self._atomic_write_csv(self.run_output_path, wide_rows, header=header)

        long_header = ["录音ID", "沟通ID", "客户类型", "客户类型判断原因", "维度", "特征", "特征权重", "特征评分", "评分原因", "该场景类型下优秀话术片段"]
        long_rows = self._build_long_rows(entries)
        final_long_output_path = self._write_primary_or_fallback_csv(
            self.run_long_output_path,
            long_rows,
            header=long_header,
            fallback_path=self.fallback_long_output_path,
        )
        self.run_long_output_path = final_long_output_path
        self._sync_latest_outputs()

    def _progress_snapshot(self, entries: List[Dict[str, Any]]) -> Dict[str, int]:
        stats = {"total": len(entries), "done": 0, "failed": 0, "pending": 0, "running": 0}
        for entry in entries:
            status = entry.get("analysis_status")
            if status == "succeeded":
                stats["done"] += 1
            elif status == "failed":
                stats["failed"] += 1
            elif status == "running":
                stats["running"] += 1
            else:
                stats["pending"] += 1
        return stats

    def _schedule_jobs(
        self,
        pending_entries: List[Dict[str, Any]],
        futures: Dict[Future[List[List[str]]], Dict[str, Any]],
        pool: ThreadPoolExecutor,
    ) -> None:
        while pending_entries and len(futures) < self.qa_workers:
            entry = pending_entries.pop(0)
            future = pool.submit(self.run_analysis_pipeline, entry)
            futures[future] = entry

    def run_batch(
        self,
        file_paths: List[Path],
        *,
        force_reanalyze: bool = False,
    ) -> None:
        entries = self.prepare_entries(file_paths, force_reanalyze=force_reanalyze)
        if not entries:
            self.logger.info("未发现可处理的录音文件。")
            return

        self.rebuild_outputs(entries)
        pending_entries = [entry for entry in entries if entry.get("analysis_status") != "succeeded"]

        self.logger.info(
            "开始批处理：总文件 %s，待全模态分析 %s。",
            len(entries),
            len(pending_entries),
        )

        last_log_at = 0.0

        with ThreadPoolExecutor(max_workers=self.qa_workers) as pool:
            futures: Dict[Future[List[List[str]]], Dict[str, Any]] = {}
            self._schedule_jobs(pending_entries, futures, pool)

            while futures or pending_entries:
                if futures:
                    done_futures, _ = wait(list(futures.keys()), timeout=1, return_when=FIRST_COMPLETED)
                else:
                    done_futures = set()

                progress_made = False

                for future in done_futures:
                    progress_made = True
                    entry = futures.pop(future)
                    try:
                        future.result()
                    except Exception as exc:
                        entry["analysis_status"] = "failed"
                        entry["error_message"] = str(exc)
                        self._upsert_entry(entry)
                        self.logger.error("全模态分析最终失败 [%s]：%s", entry["source_name"], exc)
                    finally:
                        self.rebuild_outputs(entries)

                self._schedule_jobs(pending_entries, futures, pool)

                if time.time() - last_log_at >= 30:
                    snapshot = self._progress_snapshot(entries)
                    self.logger.info(
                        "进度：总数 %s，完成 %s，失败 %s，运行中 %s，待处理 %s。",
                        snapshot["total"],
                        snapshot["done"],
                        snapshot["failed"],
                        snapshot["running"],
                        snapshot["pending"],
                    )
                    last_log_at = time.time()

                if not progress_made:
                    time.sleep(1)

        self.rebuild_outputs(entries)
        snapshot = self._progress_snapshot(entries)
        self.logger.info(
            "批处理结束：总数 %s，完成 %s，失败 %s。",
            snapshot["total"],
            snapshot["done"],
            snapshot["failed"],
        )
        self.logger.info("汇总宽表：%s", self.run_output_path)
        self.logger.info("测试汇总表：%s", self.run_long_output_path)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="销售录音质检工作流 V6")
    parser.add_argument("--api-key", default=DEFAULT_API_KEY, help="DashScope API Key")
    parser.add_argument("--input-dir", default=str(DEFAULT_INPUT_DIR), help="录音文件目录")
    parser.add_argument("--output-dir", default=str(DEFAULT_WORKSPACE), help="输出目录")
    parser.add_argument("--knowledge-dir", default=str(DEFAULT_WORKSPACE / "knowledge_bases"), help="知识库目录")
    parser.add_argument("--patterns", nargs="*", default=SUPPORTED_PATTERNS, help="录音文件匹配模式")
    parser.add_argument("--max-files", type=int, default=0, help="限制本次最多处理多少个文件，0 表示不限制")
    parser.add_argument("--qa-workers", type=int, default=2, help="全模态分析并发数")
    parser.add_argument("--max-analysis-attempts", type=int, default=2, help="单文件最大分析重试次数")
    parser.add_argument("--force-reanalyze", action="store_true", help="忽略已有结果，重新跑全部全模态质检")

    # 兼容 V5 的保留参数，避免命令切换时用户心智负担过大
    parser.add_argument("--submit-workers", type=int, default=0, help="兼容 V5 的保留参数，V6 不使用")
    parser.add_argument("--poll-workers", type=int, default=0, help="兼容 V5 的保留参数，V6 不使用")
    parser.add_argument("--max-inflight-asr", type=int, default=0, help="兼容 V5 的保留参数，V6 不使用")
    parser.add_argument("--poll-interval", type=int, default=0, help="兼容 V5 的保留参数，V6 不使用")
    parser.add_argument("--force-retranscribe", action="store_true", help="兼容参数，V6 中等价于重新跑全部分析")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    input_dir = Path(args.input_dir)
    output_dir = Path(args.output_dir)
    knowledge_dir = Path(args.knowledge_dir)

    if not input_dir.exists():
        print(f"输入目录不存在：{input_dir}")
        return 1

    workflow = SalesQAWorkflowV6(
        api_key=args.api_key,
        output_dir=output_dir,
        knowledge_dir=knowledge_dir,
        qa_workers=args.qa_workers,
        max_analysis_attempts=args.max_analysis_attempts,
    )

    file_paths = workflow.discover_audio_files(input_dir, args.patterns, max_files=args.max_files)
    if not file_paths:
        workflow.logger.info("目录下未找到匹配的录音文件。")
        return 0

    force_reanalyze = args.force_reanalyze or args.force_retranscribe
    workflow.run_batch(file_paths, force_reanalyze=force_reanalyze)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
