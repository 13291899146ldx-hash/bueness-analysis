task_id"},"inputs":{"inputParameters":[{"name":"input","input":{"type":"string","assistType":8,"value":{"type":"ref","content":{"source":"block-output","blockID":"100001","name":"input"},"rawMeta":{"type":14}}}}],"code":"import json\nimport requests\n\nasync def main(args: Args) -> Output:\n    params = args.params\n    audio_url = params.get('audio_url') or params.get('input') or \"\"\n    audio_url = audio_url.strip()\n    if not audio_url:\n        return {\"is_success\": False, \"task_id\": \"\", \"message\": \"错误：未接收到有效的音频输入链接。\"}\n        \n    api_key = \"sk-cc583ed891f6489eb4d4f7d7b2a380db\"\n    base_url = \"https://dashscope.aliyuncs.com/api/v1\"\n    submit_url = f\"{base_url}/services/audio/asr/transcription\"\n    submit_headers = {\n        \"Authorization\": f\"Bearer {api_key}\",\n        \"Content-Type\": \"application/json\",\n        \"X-DashScope-Async\": \"enable\"\n    }\n    submit_payload = {\n        \"model\": \"fun-asr\",\n        \"input\": {\n            \"file_urls\": [audio_url]\n        },\n        \"parameters\": {\n            \"language_hints\": [\"zh\", \"en\"],\n            \"diarization_enabled\": True  \n        }\n    }\n    \n    try:\n        sub_resp = requests.post(submit_url, headers=submit_headers, json=submit_payload, timeout=15)\n        if sub_resp.status_code != 200:\n            return {\"is_success\": False, \"task_id\": \"\", \"message\": f\"向阿里提交任务失败，状态码: {sub_resp.status_code}\"}\n        task_id = sub_resp.json().get('output', {}).get('task_id', '')\n    except Exception as e:\n        return {\"is_success\": False, \"task_id\": \"\", \"message\": f\"提交任务请求异常: {str(e)}\"}\n        \n    if not task_id:\n        return {\"is_success\": False, \"task_id\": \"\", \"message\": \"错误：未能从阿里云返回中获取到 task_id。\"}\n\n    # 🌟 拿到 task_id 立刻返回，耗时不到 1 秒，彻底绝育超时报错！\n    return {\n        \"is_success\": True,\n        \"task_id\": task_id,\n        \"message\": \"任务提交成功\"\n    }","language":3,"settingOnError":{"switch":false,"processType":1,"timeoutMs":60000,"retryTimes":0}},"outputs":[{"type":"string","name":"task_id","required":false},{"type":"boolean","name":"is_success","required":false},{"type":"string","name":"message","required":false}],"version":"v2"},"_temp":{"bounds":{"x":300.4240484596206,"y":-253.9855877211441,"width":360,"height":112},"externalData":{"icon":"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg","description":"编写代码，处理输入变量来生成返回值","title":"代码","mainColor":"#00B2B2"}}},{"id":"136903","type":"3","meta":{"position":{"x":1359.91723015017,"y":-279.9855877211441}},"data":{"nodeMeta":{"description":"调用大语言模型,使用变量和提示词生成回复","icon":"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg","subTitle":"大模型","title":"大模型"},"inputs":{"inputParameters":[{"name":"input","input":{"type":"list","schema":{"type":"string"},"value":{"type":"ref","content":{"source":"block-output","blockID":"167169","name":"output"},"rawMeta":{"type":99}}}}],"llmParam":[{"name":"apiMode","input":{"type":"integer","value":{"type":"literal","content":"0","rawMeta":{"type":2}}}},{"name":"maxTokens","input":{"type":"integer","value":{"type":"literal","content":"2200","rawMeta":{"type":2}}}},{"name":"spCurrentTime","input":{"type":"boolean","value":{"type":"literal","content":false,"rawMeta":{"type":3}}}},{"name":"spAntiLeak","input":{"type":"boolean","value":{"type":"literal","content":false,"rawMeta":{"type":3}}}},{"name":"thinkingType","input":{"type":"string","value":{"type":"literal","content":"disabled","rawMeta":{"type":1}}}},{"name":"responseFormat","input":{"type":"integer","value":{"type":"literal","content":"0","rawMeta":{"type":2}}}},{"name":"modleName","input":{"type":"string","value":{"type":"literal","content":"DeepSeek-V3.2","rawMeta":{"type":1}}}},{"name":"modelType","input":{"type":"integer","value":{"type":"literal","content":"1764929611","rawMeta":{"type":2}}}},{"name":"generationDiversity","input":{"type":"string","value":{"type":"literal","content":"balance","rawMeta":{"type":1}}}},{"name":"parameters","input":{"value":{"type":"object_ref"},"type":"object","schema":[]}},{"name":"prompt","input":{"type":"string","value":{"type":"literal","content":"请对以下多方角色分离录音文本（包含说话人0、1、2等模糊标签）进行逻辑研判。请首先厘清有几段展业沟通，并将旁人的插话闭环在各自对应的沟通场次内，精准剥离出销售、主要客户与旁人。最后，严格按照系统提示词（System）的要求输出。\n待分析的录音文本数据：\n\"\"\"{{input}}\n\"\"\"\n请开始通读全局并执行对话闭环重组审计：","rawMeta":{"type":1}}}},{"name":"enableChatHistory","input":{"type":"boolean","value":{"type":"literal","content":false,"rawMeta":{"type":3}}}},{"name":"chatHistoryRound","input":{"type":"integer","value":{"type":"literal","content":"3","rawMeta":{"type":2}}}},{"name":"systemPrompt","input":{"type":"string","value":{"type":"literal","content":"大模型角色定位\n你是一位拥有10年经验、精通信贷展业现场审计、擅长多方复杂对话逻辑闭环重组的顶级AI销售质检专家。你的输出结果将直接用于自动化载入飞书文档，必须严格执行格式铁律。\n\n核心工作流：对话闭环与场景还原\n在进行任何打分前，你必须通读全局文本，死死咬住上下文逻辑，对碎片化的【说话人0/1/2...】标签执行以下“对话闭环重组”：\n\n【锁定展业场次与时空切分（含空白期与破冰识别）】：\n\n时空切分铁律：由于这是线下展业录音，不同客户之间往往存在大段空白、环境杂音或无业务交流的死寂时间（销售正在线下寻找新客户）。\n\n你必须敏锐捕获这种“空白期”。当空白期结束后，一旦发现某个说话人标签再次出现标准的【销售开场破冰/问候话术】（例如：“您好，打扰一下...”、“老板，咱们聊聊...”、“请问您这边是做餐饮的吗...”、“我是XX金融的...”），代表上一个场次已经终结，判定为进入一段全新的独立展业沟通场次。\n\n【场次内部的“对话闭环”与主配角剥离】：\n\n在任何一段独立的展业沟通场次内（即从销售破冰开始，到进入下一段破冰或录音结束前），你必须通过语义逻辑研判出：谁是【销售】、谁是【主要客户】、谁是【周边插话人/旁人】。\n\n闭环铁律：在此段展业沟通期间，即便周边旁人（如客户的配偶、合伙人或在场朋友）突然插话、询问问题或发表意见，你必须将这些插话内容强行“闭环”包裹在当前这一段沟通逻辑里，绝对不能因为有新标签出现就把对话强行切断。\n\n在打分时，旁人的插话【不能】直接代表主要客户的个人意向或情绪，但主要客户对旁人插话的反应，以及销售对旁人插话的应对（例如：有无耐心解答、中间有无打断、是否合规引导），必须作为当前这一段展业沟通的打分铁证，闭环在同一个分析单元里。\n\n飞书文档结构化输出策略\n飞书文档导入铁律：为了方便数据直接复制并粘贴进飞书文档，无论录音中包含多少段独立展业沟通，最终只能输出一个统一的结构化分析报告，严禁中途重复输出格式标题。\n\n你必须通过引入“场次ID”来区分不同的客户展业段落。如果包含多段沟通，只需让“场次ID”顺延（如 场次1、场次2），分析段落直接纵向向下堆叠。\n\n14个核心评估特征与审查细则\n[维度一：客户成交意向度维度（以当前段落中“主要客户”的表现为主，闭环内的旁人插话作背景参考）]\n\n客户基本面及资质锚定：评估主客户的行业背景、具体身份、经济实力/流水、借贷经历、芝麻分、有无借贷决定权及紧急借贷需求。\n\n客户参与度：计算该段主客户输出时长占比、回应积极度、有无主动分享信息及提问次数（剔除旁人无效插话干扰）。\n\n客户情绪：观察主客户语音语调是否积极，是否出现明显的反感词汇及抗拒状态表示。\n\n客户对产品的关注度：审查主客户是否关注产品时效/成本/利息计算/手续费、有无竞品对比、是否重复询问操作方法或优惠。\n\n客户长期跟进意愿：审查主客户是否留下联系方式、有无下次沟通约定、对出示资料的态度。\n\n客户异议情况：记录主客户是否存在业务异议、是否连续循环提出异议、解答后情绪是否有明显变好。\n\n客户产生非业务沟通：观察主客户是否产生地域认同、分享个人经历、情绪宣泄或对销售产生认可关心。\n\n[维度二：销售展业维度（核心考核：销售对主客户及闭环内旁人插话的综合应对表现）]\n\n销售固定流程执行：检查销售是否亮明身份/姓名/工号/来意、是否尝试建立信任并吸引客户兴趣。\n\n销售展业状态：评估销售语音语调是否积极、展业过程中说话的流畅度、是否存在抱怨及消极状态。\n\n销售展业产品：检查销售是否清晰介绍产品信息（名称/逻辑/优势）、是否主动挖掘需求、专业词汇是否通俗易懂。\n\n销售展业合规：严厉审查销售展业中是否产生任何“合规严禁词汇”，或使用了不合规的促销技巧。\n\n销售应对客户异议：检查销售是否认真听取异议（重点审查销售在面对主客户或【旁人插话】质疑时，中间是否有打断情况）、解决态度是积极还是回避、是否达成共识。\n\n销售与客户情感链接：评估销售是否有同理心（对主客/旁人的抱怨 and 疑问是否进行了安慰和积极回复）、是否适当赞美。\n\n销售展业结果：审查销售在这次沟通中是否直接进行锁单、是否添加企微、有无驳斥客户或产生不愉快。\n\n飞书文档专用输出格式规则\n整体结构要求：输出内容必须是一个结构清晰的飞书文档正文，可以直接复制粘贴使用。禁止使用任何可能被飞书解析为代码块或特殊格式的标记符号。\n\n场次分隔规则：每一个独立的展业沟通场次必须输出完整的14行评估内容。若整篇录音有N个独立场次，则总输出按场次ID顺延排列。\n\n示例格式（使用中文标点分隔）：\n\n【场次1】\n特征1：客户基本面及资质锚定\n分数：X分\n评分原因：对话闭环结论：本段标签[说话人0]为销售，[说话人1]为主要客户，[说话人2]为旁人。具体分析内容...\n\n特征2：客户参与度\n分数：X分\n评分原因：具体分析内容...\n\n...（以此类推完成14个特征）\n\n【场次2】\n特征1：客户基本面及资质锚定\n分数：X分\n评分原因：对话闭环结论：本段标签[说话人0]为销售，[说话人3]为主要客户，无旁人。具体分析内容...\n\n...（继续输出14个特征）\n\n“分数”字段规则：必须是0到10之间的纯数字整数。若该段沟通未涉及某项，分数给0分。\n\n“评分原因”字段规则（飞书文档防错位防混乱铁律）：\n\n该字段的第一句，必须写明本段的对话闭环与主配角识别结论，格式固定为：【对话闭环结论：本段标签[说话人X]为销售，[说话人Y]为主要客户，[说话人Z]为旁人】。随后紧跟具体分析。\n\n必须精准摘录该段内相关的【原话或具体时间戳（如 15点4秒）】作为打分铁证。\n\n飞书文档防解析崩溃规则：该字段整段文字绝对禁止包含任何英文标点符号（如英文逗号、英文句号、英文双引号、英文单引号、斜杠等）和【任何形式的换行符】！凡是分析过程中需要停顿或引用原话的，必须一律且强制替换为中文标点符号（中文逗号，中文句号。中文括号（））。确保每一行评估内容在飞书文档中是清晰可读的单行文本。\n\n输出纯净规则：整个输出中【绝对禁止】包含任何代码块标记（如```）、Markdown语法符号（如#、*、-等）、HTML标签或任何可能被飞书误解析为格式指令的字符。一上来就直接输出【场次1】及后续内容，不得添加任何前言、后缀或多余的提示性解释。","rawMeta":{"type":1}}}},{"name":"stableSystemPrompt","input":{"type":"string","value":{"type":"literal","content":"","rawMeta":{"type":1}}}},{"name":"canContinue","input":{"type":"boolean","value":{"type":"literal","content":false,"rawMeta":{"type":3}}}},{"name":"loopPromptVersion","input":{"type":"string","value":{"type":"literal","content":"","rawMeta":{"type":1}}}},{"name":"loopPromptName","input":{"type":"string","value":{"type":"literal","content":"","rawMeta":{"type":1}}}},{"name":"loopPromptId