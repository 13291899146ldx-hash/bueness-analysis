轮...\"\n                }\n                \n            # 如果阿里明确返回失败\n            if task_status == \"FAILED\":\n                return {\n                    \"task_status\": \"FAILED\", \n                    \"is_success\": False, \n                    \"pure_chat_text\": f\"阿里云后台转写失败: {output_data.get('message','')}\"\n                }\n                \n            # 🌟 核心改动 2：只有真正成功了，才去下载并清洗大长串文本\n            if task_status == \"SUCCEEDED\":\n                download_url = output_data.get('transcription_url') or output_data.get('file_url')\n                if not download_url and 'results' in output_data:\n                    results_list = output_data.get('results', [])\n                    if results_list and isinstance(results_list, list):\n                        download_url = results_list[0].get('transcription_url') or results_list[0].get('file_url')\n                        \n                if not download_url:\n                    return {\"task_status\": \"PENDING\", \"is_success\": False, \"pure_chat_text\": \"未找到文本下载链接\"}\n                    \n                # 去下载阿里的 json 文本\n                file_resp = requests.get(download_url, timeout=15)\n                file_json = file_resp.json()\n                \n                output_lines = []\n                transcripts = file_json.get('transcripts', [])\n                for transcript in transcripts:\n                    sentences = transcript.get('sentences', [])\n                    for sentence in sentences:\n                        text = sentence.get('text', '')\n                        speaker_id = sentence.get('speaker_id', '未知')\n                        begin_time = sentence.get('begin_time', 0)\n                        time_sec = begin_time / 1000.0\n                        output_lines.append(f\"[{time_sec:.1f}s] 说话人{speaker_id}: {text}\")\n                        \n                final_chat_text = \"\\n\".join(output_lines)\n                \n                return {\n                    \"task_status\": \"SUCCEEDED\",\n                    \"is_success\": True,\n                    \"pure_chat_text\": final_chat_text\n                }\n                \n    except Exception as e:\n        # 网络抖动兜底\n        return {\n            \"task_status\": \"PENDING\", \n            \"is_success\": False, \n            \"pure_chat_text\": f\"网络轮询产生轻微抖动: {str(e)}\"\n        }\n\n    return {\"task_status\": \"PENDING\", \"is_success\": False, \"pure_chat_text\": \"未捕获的阿里未知状态\"}","language":3,"settingOnError":{"switch":false,"dataOnErr":"{\n    \"task_status\": \"\",\n    \"is_success\": false,\n    \"pure_chat_text\": \"\"\n}","processType":1,"timeoutMs":60000,"retryTimes":0}},"outputs":[{"type":"string","name":"task_status","required":false},{"type":"boolean","name":"is_success","required":false},{"type":"string","name":"pure_chat_text","required":false}],"version":"v2"},"_temp":{"bounds":{"x":557.3410572007018,"y":173.9727104217079,"width":360,"height":112},"externalData":{"icon":"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg","description":"编写代码，处理输入变量来生成返回值","title":"代码","mainColor":"#00B2B2"}}},{"id":"117730","type":"8","meta":{"position":{"x":1100,"y":0}},"data":{"nodeMeta":{"description":"连接多个下游分支，若设定的条件成立则仅运行对应的分支，若均不成立则只运行“否则”分支","icon":"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Condition-v2.jpg","mainColor":"#00B2B2","subTitle":"选择器","title":"成功则进入大模型分析，失败则重新循环"},"inputs":{"branches":[{"condition":{"logic":2,"conditions":[{"operator":1,"left":{"input":{"type":"string","value":{"type":"ref","content":{"source":"block-output","blockID":"134716","name":"task_status"},"rawMeta":{"type":1}}}},"right":{"input":{"type":"string","value":{"type":"literal","content":"SUCCEEDED","rawMeta":{"type":1}}}}}]}}]}},"_temp":{"bounds":{"x":1017.3410572007019,"y":160.9727104217079,"width":360,"height":138},"externalData":{"icon":"https://lf3-static.bytednsdoc