    def run(self, local_file_path: str, filename: str):
        print(f"开始处理: {local_file_path}")
        success, task_id, msg = self.submit_asr_task(local_file_path)
        if not success: return print(msg)
        chat_text = self.poll_asr_until_complete(task_id)
        if not chat_text: return print("转写失败")
        qa_report = self.qa_analysis(chat_text)
        with open(os.path.join(self.output_dir, filename), "w", encoding="utf-8-sig") as f:
            f.write(qa_report.strip())
        print(f" 完成: {os.path.join(self.output_dir, filename)}")

