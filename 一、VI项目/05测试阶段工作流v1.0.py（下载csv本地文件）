import os
import time
import requests
from typing import Dict, Any, Optional, Tuple

class SalesQAWorkflow:
    def __init__(self, api_key: str, output_dir: str = r"D:\audieo"):
        self.api_key = api_key
        self.base_url = "https://dashscope.aliyuncs.com/api/v1"
        self.output_dir = output_dir
        if not os.path.exists(self.output_dir):
            os.makedirs(self.output_dir)

    def submit_asr_task(self, local_file_path: str) -> Tuple[bool, str, str]:
        """
        """
        if not os.path.exists(local_file_path):
            return False, "", f"文件路径不存在: {local_file_path}"
            
        try:
            policy_url = f"{self.base_url}/uploads"
            params = {"action": "getPolicy", "model": "fun-asr"}
            headers = {"Authorization": f"Bearer {self.api_key}"}
            policy_resp = requests.get(policy_url, headers=headers, params=params)
            if policy_resp.status_code != 200:
                return False, "", f"获取上传凭证失败: {policy_resp.text}"
            policy = policy_resp.json().get('data')
            file_name = os.path.basename(local_file_path)
            key = f"{policy['upload_dir']}/{file_name}"
            with open(local_file_path, 'rb') as f:
                # 关键修复：加入 policy 中要求的 x-oss-object-acl 和 x-oss-forbid-overwrite
                files = {
                    'key': (None, key),
                    'OSSAccessKeyId': (None, policy['oss_access_key_id']),
                    'policy': (None, policy['policy']),
                    'Signature': (None, policy['signature']),
                    'x-oss-object-acl': (None, 'private'),  
                    'x-oss-forbid-overwrite': (None, 'true'), 
                    'success_action_status': (None, '200'),
                    'file': (file_name, f)
                }
                upload_resp = requests.post(policy['upload_host'], files=files)
            
            if upload_resp.status_code != 200:
                return False, "", f"文件上传OSS失败: {upload_resp.text}"
            submit_url = f"{self.base_url}/services/audio/asr/transcription"
            headers = {
                "Authorization": f"Bearer {self.api_key}",
                "Content-Type": "application/json",
                "X-DashScope-Async": "enable",
                "X-DashScope-OssResourceResolve": "enable"
            }
            payload = {
                "model": "fun-asr",
                "input": {"file_urls": [f"oss://{key}"]},
                "parameters": {"diarization_enabled": True}
            }
            
            res = requests.post(submit_url, headers=headers, json=payload)
            json_resp = res.json()
            if 'output' in json_resp and 'task_id' in json_resp['output']:
                return True, json_resp['output']['task_id'], "提交成功"
            else:
                return False, "", f"服务器响应异常: {json_resp}"      
        except Exception as e:
            return False, "", f"流程执行异常: {str(e)}"
    def query_asr_result(self, task_id: str) -> Dict[str, Any]:
        query_url = f"{self.base_url}/tasks/{task_id}"
        headers = {"Authorization": f"Bearer {self.api_key}"}
        response = requests.get(query_url, headers=headers)
        output_data = response.json().get('output', {})
        task_status = output_data.get('task_status', '')

        if task_status == "SUCCEEDED":
            results = output_data.get('results', [])
            if not results:
                return {"task_status": "WAITING", "pure_chat_text": ""}
            
            download_url = results[0].get('transcription_url')
            
            if not download_url:
                return {"task_status": "WAITING", "pure_chat_text": ""}
            file_resp = requests.get(download_url, headers=headers)
            if file_resp.status_code != 200:
                print(f"DEBUG: 下载识别结果失败: {file_resp.text}")
                return {"task_status": "FAILED", "pure_chat_text": ""}
      
            lines = []
            for transcript in file_resp.json().get('transcripts', []):
                for sentence in transcript.get('sentences', []):
                    lines.append(f"说话人{sentence.get('speaker_id', '0')}: {sentence.get('text', '')}")
            
            return {"task_status": "SUCCEEDED", "pure_chat_text": "\n".join(lines)}
            
        return {"task_status": task_status, "pure_chat_text": ""}

    def poll_asr_until_complete(self, task_id: str) -> Optional[str]:
        for _ in range(60):
            res = self.query_asr_result(task_id)
            if res["task_status"] == "SUCCEEDED": return res["pure_chat_text"]
            if res["task_status"] == "FAILED": return None
            time.sleep(5)
        return None

    def qa_analysis(self, chat_text: str) -> str:
        system_prompt = """#大模型角色定位：
